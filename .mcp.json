{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "lightswind": {
      "command": "npx",
      "args": ["-y", "lightswind@latest", "mcp"]
    },
    "better-icons": {
      "command": "npx",
      "args": ["-y", "better-icons"]
    },
    "aria-icons": {
      "command": "npx",
      "args": ["-y", "aria-icons", "mcp"]
    },
    "mcp-universal-icons": {
      "command": "npx",
      "args": ["-y", "mcp-universal-icons"]
    },
    "iconify-mcp": {
      "command": "npx",
      "args": ["-y", "iconify-mcp-server"]
    },
    "lucide-icons-mcp": {
      "command": "npx",
      "args": ["-y", "lucide-icons-mcp"]
    }
  }
}
